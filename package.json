{
  "name": "eventquest",
  "private": true,
  "version": "0.1.0",
  "description": "EventQuest — Solana Devnet attendance and gamification platform for in-person events.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./apps/web build",
    "dev:web": "pnpm --filter=./apps/web dev",
    "test:ts": "pnpm -r --filter=./apps/web test",
    "test:e2e": "pnpm --filter=./apps/web exec playwright test",
    "devnet:smoke": "tsx scripts/devnet-smoke-test.ts",
    "devnet:verify-config": "bash scripts/verify-devnet-config.sh"
  }
}
